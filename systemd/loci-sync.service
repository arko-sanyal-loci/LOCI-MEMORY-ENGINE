[Unit]
Description=Loci Memory Engine Real-Time Node Sync Daemon
After=network.target loci-mcp.service
Wants=loci-mcp.service
Documentation=https://github.com/arko-sanyal2/loci-memory-engine

[Service]
Type=simple
WorkingDirectory=%h/loci-memory-engine
ExecStart=/usr/bin/python3 -m loci_engine.node_sync_daemon
Restart=always
RestartSec=5s
Environment=LOCI_NODE_ID=%H
Environment=LOCI_SYNC_POLL_INTERVAL=0.5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/loci-memory-engine
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=loci-sync

[Install]
WantedBy=default.target
