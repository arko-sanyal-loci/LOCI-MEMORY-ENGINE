# ==============================================================================
# Environment Configuration for Billo & LOCI Unified System
# ==============================================================================

# Network & Server Settings
HOST=0.0.0.0
PORT=8000
DOMAIN=billo.tech
ARC_DOMAIN=arc.billo.tech
BILLO_VPS_HOST=

# SQLite Storage Path
BILLO_DB_PATH=data/context2.db

# Ollama Endpoint Configuration
# GPU Workstation: qwen2.5-coder:14b on port 11434
OLLAMA_GPU_URL=http://localhost:11434
# Local Workstation SSH tunnel to VPS: port 11435 -> VPS:11434
OLLAMA_VPS_TUNNEL=http://localhost:11435
# Direct VPS local loopback: port 11434
OLLAMA_VPS_DIRECT=http://127.0.0.1:11434

# Model Names
MODEL_GPU=qwen2.5-coder:14b
MODEL_VPS=qwen2.5:3b

# Inference Timeouts (seconds)
TIMEOUT_VPS_COMPRESS=60.0

# Workstation Overrides
FORCE_GPU_WORKSTATION=0
