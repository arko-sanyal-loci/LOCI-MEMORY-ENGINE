+"""
+Tests for loci_engine.store — entity-level persistence on top of
+storage.py's context2.db, with heat always re-derived from the full
+event history (never cached as a drifting mutable scalar).
+"""
+
+import os
+import tempfile
+import unittest
+
+from loci_engine import store
+
+
+class TestStoreEntities(unittest.TestCase):
+    def setUp(self):
+        self.temp_db = tempfile.NamedTemporaryFile(delete=False, suffix=".db")
+        self.temp_db.close()
+        self.conn = store.open_db(self.temp_db.name)
+
+    def tearDown(self):
+        self.conn.close()
+        os.unlink(self.temp_db.name)
+
+    def test_get_missing_entity_returns_none(self):
+        self.assertIsNone(store.get_entity(self.conn, "nope", now=0.0))
+
+    def test_remember_entity_is_idempotent(self):
+        a = store.remember_entity(self.conn, "pattern_a", gist="first call", now=0.0)
+        b = store.remember_entity(self.conn, "pattern_a", gist="second call", now=1.0)
+        self.assertEqual(a["id"], b["id"])
+        # gist from the second call must not overwrite the first
+        self.assertEqual(a["canonical_text"], "first call")
+
+    def test_touch_entity_requires_existing_entity(self):
+        with self.assertRaises(KeyError):
+            store.touch_entity(self.conn, "nonexistent", now=0.0)
+
+    def test_touch_entity_reinforces_heat_over_time(self):
+        store.remember_entity(self.conn, "pattern_b", gist="trust me", now=0.0)
+        h1 = store.touch_entity(self.conn, "pattern_b", hop=0.1, now=0.0)
+        h2 = store.touch_entity(self.conn, "pattern_b", hop=0.1, now=1.0)
+        self.assertGreater(h2, h1)
+
+    def test_heat_never_reaches_open_interval_bounds(self):
+        store.remember_entity(self.conn, "pattern_c", gist="stress test", now=0.0)
+        heat = 0.0
+        for i in range(50):
+            heat = store.touch_entity(self.conn, "pattern_c", hop=0.3, now=float(i))
+        self.assertLess(heat, 1.0)
+        self.assertGreater(heat, 0.0)
+
+    def test_get_entity_rederives_heat_not_cached(self):
+        """Reading heat twice at different 'now' values without touching
+        must produce different heat — proof it's recomputed, not read
+        back verbatim from a stored column."""
+        store.remember_entity(self.conn, "pattern_d", gist="aging test", now=0.0)
+        store.touch_entity(self.conn, "pattern_d", hop=0.2, now=0.0)
+        record_soon = store.get_entity(self.conn, "pattern_d", now=1.0)
+        record_later = store.get_entity(self.conn, "pattern_d", now=1000.0)
+        self.assertNotEqual(record_soon["heat"], record_later["heat"])
+
+
+if __name__ == "__main__":
+    unittest.main()
