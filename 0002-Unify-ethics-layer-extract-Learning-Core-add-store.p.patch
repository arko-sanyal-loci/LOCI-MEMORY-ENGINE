+++ b/tests/test_ethics.py
@@ -0,0 +1,118 @@
+"""
+Tests for loci_engine.ethics — observe-only valence, conflict, trust, and
+provenance layer (Philosophical Spine; Clusters A4, B3-B10, B14).
+
+These tests cover the parts of ethics.py that integrate with the rest of
+the unified codebase: trust-pattern tracking via store.py, scar heat via
+heat.py, and the provenance ledger's own conclusion/evidence machinery.
+Every function here is observe-only — these tests assert what gets
+recorded and returned, never that anything was blocked or executed.
+"""
+
+import os
+import tempfile
+import unittest
+
+from loci_engine import ethics, store
+
+
+class TestScoreVexec(unittest.TestCase):
+    def test_open_interval_bounds(self):
+        v = ethics.score_vexec(intent=1.0, consent=1.0)
+        self.assertLess(v, 1.0)
+        self.assertGreater(v, -1.0)
+
+
+class TestIrreversibleActionGate(unittest.TestCase):
+    def test_flags_irreversible_destructive_action(self):
+        result = ethics.irreversible_action_gate(
+            is_irreversible_or_destructive=True,
+            user_shows_nontechnical_pattern=True,
+        )
+        self.assertIsInstance(result, dict)
+
+
+class TestPatternTrustViaStore(unittest.TestCase):
+    """record_pattern_trust_event / record_confirmed_breach are ethics.py's
+    bridge into store.py — this is the integration seam this unification
+    pass exists to prove works end-to-end."""
+
+    def setUp(self):
+        self.temp_db = tempfile.NamedTemporaryFile(delete=False, suffix=".db")
+        self.temp_db.close()
+        self.conn = store.open_db(self.temp_db.name)
+
+    def tearDown(self):
+        self.conn.close()
+        os.unlink(self.temp_db.name)
+
+    def test_first_touch_creates_entity_with_valid_tier(self):
+        result = ethics.record_pattern_trust_event(
+            self.conn, "unify_test_pattern", hop=0.1, now=0.0
+        )
+        self.assertEqual(result["pattern"], "unify_test_pattern")
+        self.assertIn(result["tier"], {"hot", "warm", "cool", "cold"})
+        self.assertGreater(result["trust_heat"], 0.0)
+        self.assertLess(result["trust_heat"], 1.0)
+
+    def test_repeated_touches_reinforce_trust(self):
+        ethics.record_pattern_trust_event(self.conn, "p2", hop=0.2, now=0.0)
+        later = ethics.record_pattern_trust_event(self.conn, "p2", hop=0.2, now=1.0)
+        self.assertGreater(later["trust_heat"], 0.0)
+
+    def test_confirmed_breach_is_recorded(self):
+        ethics.record_pattern_trust_event(self.conn, "p3", hop=0.3, now=0.0)
+        breach = ethics.record_confirmed_breach(self.conn, "p3", now=1.0)
+        self.assertIsInstance(breach, dict)
+
+
+class TestProvenanceLedgerFlow(unittest.TestCase):
+    """Exercises the evidence -> conclusion -> completeness-check chain
+    that threads.py and aethel_council.py both build on top of."""
+
+    def setUp(self):
+        self.ledger = ethics.ProvenanceLedger()
+
+    def test_record_and_check_single_source(self):
+        health = ethics.communication_health_check(True)
+        ethics.record_evidence_source(
+            self.ledger,
+            topic="unify_topic",
+            source_id="src_1",
+            description="first source",
+            communication_health=health,
+            now=0.0,
+        )
+        check = ethics.data_completeness_check(self.ledger, "unify_topic", now=1.0)
+        self.assertIsInstance(check, dict)
+
+    def test_conclusion_is_recorded_with_provenance(self):
+        result = ethics.record_conclusion(
+            self.ledger,
+            author_id="ARKO",
+            topic="unify_topic",
+            conclusion="test conclusion",
+            now=0.0,
+        )
+        self.assertIsInstance(result, dict)
+        entries = ethics.entries_for_topic(self.ledger, "unify_topic")
+        self.assertTrue(len(entries) >= 1)
+
+
+class TestScarMechanism(unittest.TestCase):
+    """Scar heat must re-derive from the full ledger history via heat.py,
+    never from a single cached scalar — same discipline as store.py."""
+
+    def test_scar_event_and_heat_round_trip(self):
+        ledger = ethics.ProvenanceLedger()
+        ethics.record_scar_event(
+            ledger, "unify_scar", relevance=1.0, valence_weight=-1.0, now=0.0
+        )
+        heat_info = ethics.get_scar_heat(ledger, "unify_scar", now=1.0)
+        self.assertGreater(heat_info["scar_heat"], 0.0)
+        self.assertLess(heat_info["scar_heat"], 1.0)
+        self.assertTrue(heat_info["never_reaches_one"])
+
+
+if __name__ == "__main__":
+    unittest.main()
