+++ b/loci_engine/threads.py
@@ -0,0 +1,400 @@
+"""Unified comms/threads routing layer — Aethel OS.
+
+**What this is:**
+A thin routing layer over `ethics.ProvenanceLedger` that gives commit-trailer
+conventions (and any other participant in Aethel OS — human, model, agent) a
+single, consistent API for the existing evidence-source / conclusion machinery.
+
+A "thread" is already modelled by `ethics.py`'s `topic` concept.  This module
+adds nothing new to the ledger; it maps the Aethel OS comms vocabulary onto the
+calls that are already there, so the vocabulary is consistent across every entry
+point (commit hook, MCP tool, direct Python call) and the same
+sync-before-conclusion gate fires everywhere.
+
+**OBSERVE-ONLY, BY DESIGN (same discipline as ethics.py / goodwill.py)**
+`threads.py` does not block, gate, retry, or act on its own.  It computes,
+records, and routes — the caller wires the result into whatever decision path
+they own.
+
+**Commit trailer convention — mapping (per MANIFEST.md chain invariants):**
+
+  Regex: (?i)(Closes|Helps|Mitigates|RFP|ITP): ?#?(\\d+)
+
+  Closes    → record_conclusion()      (STOP signal; sync-before-conclusion gate fires)
+  Helps     → record_evidence_source() (REPORT signal; must pass comms-health check)
+  Mitigates → record_evidence_source() (MITIGATE signal; partial evidence, topic stays open)
+  RFP       → record_evidence_source() (REQUEST_FOR_PARTICIPATION; populates aethel_council)
+  ITP       → record_evidence_source() (INTENT_TO_PARTICIPATE; registers pending member)
+
+**What this module does NOT do, stated plainly:**
+  - It does not parse git commit messages from disk — the caller supplies the
+    already-extracted trailer string or structured dict.
+  - It does not enforce authorship (author_id is caller-supplied, same as
+    every other ledger write in this project).
+  - It does not create or delete issues/tickets — thread IDs are arbitrary
+    caller-supplied strings; this module has no concept of an issue tracker.
+  - It does not merge or deduplicate threads — each `topic` is its own
+    independent evidence + conclusion sequence in the underlying ledger.
+
+**Open gaps, named directly:**
+  - `open_threads()` requires a full ledger scan — O(ledger size).  This is
+    acceptable for the current append-only `.jsonl` store; a future indexed
+    store would allow a cheaper query.
+  - `aethel_council` membership is NOT automatically populated here when an
+    `RFP`/`ITP` trailer is processed.  The caller must explicitly call
+    `aethel_council.register_council_member()` — this module records the
+    participation intent into the ledger, but does not write into the council's
+    own separate membership registry.  That integration is a separate wiring
+    step, named rather than silently skipped.
+  - `communication_health_check()` is required by `record_evidence_source()`
+    in ethics.py.  The `engaged_with_substance` argument is still
+    caller-supplied judgment (same uncalibrated-threshold-honest status as
+    everywhere else in this project).
+"""
+from __future__ import annotations
+
+import re
+import time
+from typing import Any, Optional
+
+from loci_engine import ethics
+
+# ---------------------------------------------------------------------------
+# Trailer vocabulary
+# ---------------------------------------------------------------------------
+
+#: The canonical regex for commit trailer parsing.  Matches the trailer keyword
+#: (Closes/Helps/Mitigates/RFP/ITP), an optional space, an optional '#', and
+#: the thread/issue ID (digits for git-style, or any non-whitespace string).
+TRAILER_PATTERN = re.compile(
+    r'(?i)(Closes|Helps|Mitigates|RFP|ITP):\s*#?(\S+)',
+)
+
+#: Mapping from trailer keyword (lowercase) to the role_tag written into the
+#: ledger, so downstream readers can filter by role_tag without re-parsing
+#: the trailer keyword.
+TRAILER_ROLE_TAGS: dict[str, str] = {
+    'closes':    'thread_conclusion_stop',
+    'helps':     'thread_evidence_report',
+    'mitigates': 'thread_evidence_mitigate',
+    'rfp':       'thread_evidence_rfp',
+    'itp':       'thread_evidence_itp',
+}
+
+#: Role tags that represent a conclusion (Close / STOP signal).
+CONCLUSION_ROLE_TAGS = frozenset({'thread_conclusion_stop'})
+
+#: Role tags that represent open evidence (topic stays open after these).
+EVIDENCE_ROLE_TAGS = frozenset({
+    'thread_evidence_report',
+    'thread_evidence_mitigate',
+    'thread_evidence_rfp',
+    'thread_evidence_itp',
+})
+
+
+# ---------------------------------------------------------------------------
+# Core routing functions
+# ---------------------------------------------------------------------------
+
+def post_evidence(
+    ledger: "ethics.ProvenanceLedger",
+    topic: str,
+    author_id: str,
+    summary: str,
+    trailer_keyword: str,
+    engaged_with_substance: bool = True,
+    source_description: str = "",
+    now: float | None = None,
+) -> dict:
+    """Route an evidence-class trailer (Helps / Mitigates / RFP / ITP) into
+    the ledger via `ethics.record_evidence_source`.
+
+    `engaged_with_substance` is the communication_health_check result — see
+    ethics.py's own docstring: "a judgment call the caller must supply."
+    Defaults to True for commit-context posts (the act of writing a trailer
+    in a commit message is itself a form of substantive engagement), but the
+    caller can override for cases where communication health is questionable.
+
+    Returns the dict from `record_evidence_source`, which includes the ledger
+    entry hash and the communication_health_check result.
+    """
+    now = time.time() if now is None else now
+    keyword = trailer_keyword.lower()
+    role_tag = TRAILER_ROLE_TAGS.get(keyword, f'thread_evidence_{keyword}')
+
+    health = ethics.communication_health_check(
+        engaged_with_substance=engaged_with_substance,
+    )
+
+    # source_id encodes the trailer keyword + short summary so downstream
+    # readers can distinguish multiple evidence entries on the same topic
+    # without having to parse the description field.
+    source_id = f"{trailer_keyword.upper()}:{summary[:80]}"
+
+    result = ethics.record_evidence_source(
+        ledger=ledger,
+        topic=topic,
+        source_id=source_id,
+        description=source_description or f"[{trailer_keyword}] {summary}",
+        communication_health=health,
+        now=now,
+    )
+    return {**result, 'role_tag': role_tag, 'topic': topic}
+
+
+def post_conclusion(
+    ledger: "ethics.ProvenanceLedger",
+    topic: str,
+    author_id: str,
+    conclusion: str,
+    acknowledged_prior_hashes: list[str],
+    now: float | None = None,
+) -> dict:
+    """Route a Closes trailer into the ledger via `ethics.record_conclusion`.
+
+    The sync-before-conclusion gate fires here: if any prior ledger entries
+    for this topic have not been acknowledged (passed in
+    `acknowledged_prior_hashes`), the conclusion is refused and the
+    unacknowledged entries are returned so the caller can surface them.
+
+    This is the Aethel OS STOP signal — it does not delete or suppress prior
+    evidence; it records that the thread is considered resolved, subject to
+    the gate having passed.
+    """
+    now = time.time() if now is None else now
+    return ethics.record_conclusion(
+        ledger=ledger,
+        author_id=author_id,
+        topic=topic,
+        conclusion=conclusion,
+        acknowledged_prior_hashes=acknowledged_prior_hashes,
+        now=now,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Trailer parser — commit message → routing calls
+# ---------------------------------------------------------------------------
+
+def parse_trailers(text: str) -> list[dict]:
+    """Extract all Aethel OS trailers from a commit message (or any text).
+
+    Returns a list of dicts, one per match::
+
+        {
+            'keyword':  'Closes',         # original case from the text
+            'topic':    '42',             # the thread/issue ID as a string
+            'role_tag': 'thread_conclusion_stop',
+            'is_conclusion': True,
+        }
+
+    Does not touch the ledger — this is a pure parse step so callers can
+    inspect what would be posted before committing to the write.
+    """
+    matches = []
+    for m in TRAILER_PATTERN.finditer(text):
+        keyword = m.group(1)
+        topic   = m.group(2)
+        role_tag = TRAILER_ROLE_TAGS.get(keyword.lower(), f'thread_evidence_{keyword.lower()}')
+        matches.append({
+            'keyword':       keyword,
+            'topic':         topic,
+            'role_tag':      role_tag,
+            'is_conclusion': role_tag in CONCLUSION_ROLE_TAGS,
+        })
+    return matches
+
+
+def route_commit_message(
+    ledger: "ethics.ProvenanceLedger",
+    commit_message: str,
+    author_id: str,
+    acknowledged_prior_hashes: dict[str, list[str]] | None = None,
+    engaged_with_substance: bool = True,
+    now: float | None = None,
+) -> list[dict]:
+    """Parse every Aethel OS trailer in `commit_message` and route each one
+    to the correct ledger call.
+
+    `acknowledged_prior_hashes` is a dict keyed by topic string, mapping each
+    topic to the list of ledger entry hashes the caller is acknowledging before
+    a Closes trailer.  Required for any Closes trailer to succeed; if a topic
+    appears in a Closes trailer but is absent from `acknowledged_prior_hashes`,
+    that trailer is routed as if `acknowledged_prior_hashes=[]` for that topic
+    (which will cause the sync-before-conclusion gate to refuse it and return
+    the unacknowledged entries).
+
+    Returns one result dict per trailer, in the order they appeared in the
+    message.  Each dict includes `accepted` (True/False), `topic`, `role_tag`,
+    and either the ledger entry hash (on success) or the `unacknowledged_entries`
+    (when a Closes trailer was refused by the gate).
+    """
+    now = time.time() if now is None else now
+    ack = acknowledged_prior_hashes or {}
+    trailers = parse_trailers(commit_message)
+    results  = []
+
+    for trailer in trailers:
+        topic   = trailer['topic']
+        keyword = trailer['keyword']
+
+        if trailer['is_conclusion']:
+            result = post_conclusion(
+                ledger=ledger,
+                topic=topic,
+                author_id=author_id,
+                conclusion=commit_message,
+                acknowledged_prior_hashes=ack.get(topic, []),
+                now=now,
+            )
+            results.append({**result, 'keyword': keyword, 'topic': topic,
+                             'role_tag': trailer['role_tag']})
+        else:
+            result = post_evidence(
+                ledger=ledger,
+                topic=topic,
+                author_id=author_id,
+                summary=commit_message,
+                trailer_keyword=keyword,
+                engaged_with_substance=engaged_with_substance,
+                now=now,
+            )
+            results.append({**result, 'keyword': keyword})
+
+    return results
+
+
+# ---------------------------------------------------------------------------
+# Thread state queries
+# ---------------------------------------------------------------------------
+
+def open_threads(ledger: "ethics.ProvenanceLedger") -> list[dict]:
+    """Return every topic that has at least one evidence entry but no accepted
+    conclusion yet.
+
+    O(ledger size) — full scan over all entries.  Acceptable for the current
+    append-only `.jsonl` store; a future indexed store would need only a
+    topic-keyed index.
+
+    A topic is "open" when:
+      - At least one entry with a role_tag in EVIDENCE_ROLE_TAGS exists for it, AND
+      - No entry with a role_tag in CONCLUSION_ROLE_TAGS AND accepted=True exists.
+
+    Returns a list of dicts::
+
+        {
+            'topic':          '42',
+            'evidence_count': 3,
+            'last_activity':  1730305800.0,   # Unix timestamp
+            'authors':        ['ARKO', 'ARC'],
+        }
+    """
+    topic_evidence: dict[str, dict] = {}
+    closed_topics:  set[str]        = set()
+
+    for entry in ledger.entries():
+        payload  = entry.get('payload', {})
+        role_tag = payload.get('role_tag', entry.get('role_tag', ''))
+        topic    = payload.get('topic') or payload.get('extra_payload', {}).get('topic')
+
+        if topic is None:
+            continue
+
+        if role_tag in CONCLUSION_ROLE_TAGS:
+            # Only a conclusion that the gate accepted counts as closed.
+            if payload.get('accepted', True):   # default True: older records pre-gate
+                closed_topics.add(topic)
+        elif role_tag in EVIDENCE_ROLE_TAGS:
+            rec = topic_evidence.setdefault(topic, {
+                'topic': topic, 'evidence_count': 0,
+                'last_activity': 0.0, 'authors': [],
+            })
+            rec['evidence_count'] += 1
+            ts = entry.get('ts', 0.0)
+            if ts > rec['last_activity']:
+                rec['last_activity'] = ts
+            aid = entry.get('author_id', '')
+            if aid and aid not in rec['authors']:
+                rec['authors'].append(aid)
+
+    return [v for k, v in topic_evidence.items() if k not in closed_topics]
+
+
+def thread_status(
+    ledger: "ethics.ProvenanceLedger",
+    topic: str,
+    conn: Any | None = None,
+) -> dict:
+    """Return the full status of a single thread.
+
+    Wraps `ethics.data_completeness_check` (evidence health) and, if an
+    aethel_council `conn` is provided, also calls
+    `aethel_council.has_every_member_been_heard` for the given topic.
+
+    Returns::
+
+        {
+            'topic':               '42',
+            'data_completeness':   {...},   # from ethics.data_completeness_check
+            'council_gate':        {...},   # from aethel_council (if conn supplied)
+            'open':                True,    # False once a conclusion is accepted
+            'conclusion':          None,    # the accepted conclusion payload, if any
+        }
+    """
+    # Gather all entries for this topic
+    topic_entries = [
+        e for e in ledger.entries()
+        if (e.get('payload', {}).get('topic') == topic or
+            e.get('payload', {}).get('extra_payload', {}).get('topic') == topic)
+    ]
+
+    # Check for an accepted conclusion
+    conclusion_entry = None
+    for e in topic_entries:
+        role_tag = e.get('payload', {}).get('role_tag', '')
+        if role_tag in CONCLUSION_ROLE_TAGS and e.get('payload', {}).get('accepted', True):
+            conclusion_entry = e.get('payload')
+            break
+
+    # data_completeness_check expects a topic string; it will scan the ledger
+    completeness = ethics.data_completeness_check(ledger=ledger, topic=topic)
+
+    status: dict = {
+        'topic':             topic,
+        'data_completeness': completeness,
+        'council_gate':      None,
+        'open':              conclusion_entry is None,
+        'conclusion':        conclusion_entry,
+    }
+
+    if conn is not None:
+        try:
+            from loci_engine import aethel_council
+            status['council_gate'] = aethel_council.has_every_member_been_heard(
+                conn=conn, topic=topic
+            )
+        except Exception as exc:
+            status['council_gate'] = {
+                'error': str(exc),
+                'note': 'aethel_council query failed — conn may not have the council schema',
+            }
+
+    return status
+
+
+# ---------------------------------------------------------------------------
+# Convenience: list all topics with any ledger activity
+# ---------------------------------------------------------------------------
+
+def known_topics(ledger: "ethics.ProvenanceLedger") -> list[str]:
+    """Return a deduplicated, sorted list of every topic that has at least one
+    ledger entry, open or closed.  Cheap alternative to `open_threads` when
+    only the topic IDs are needed."""
+    seen: set[str] = set()
+    for entry in ledger.entries():
+        payload = entry.get('payload', {})
+        t = payload.get('topic') or payload.get('extra_payload', {}).get('topic')
+        if t:
+            seen.add(t)
+    return sorted(seen)
