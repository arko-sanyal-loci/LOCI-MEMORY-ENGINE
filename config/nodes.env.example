# LOCI cluster node topology — TEMPLATE.
#
# Copy to config/nodes.env (git-ignored) and fill in real values:
#     cp config/nodes.env.example config/nodes.env
# Every script in scripts/ and scripts/ops/ and loci_engine/node_sync_daemon.py
# reads this file. Real host names, IPs and user names must never be committed.

# Active core nodes
WORKSTATION_IP="192.168.x.x"
CONSOLE_IP="192.168.x.x"
CONSOLE_USER="your-user"
VPS_HOST="vps.example.com"
VPS_USER="loci"            # prefer a non-root deploy user
VPS_PATH="/home/loci/loci-memory-engine"

# Staged nodes (fill in once assigned)
MAC_MINI_IP=""
MAC_MINI_USER=""
MAC_MINI_PATH="~/loci-memory-engine"

